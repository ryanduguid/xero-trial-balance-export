# Copy to .env and fill in from your app at developer.xero.com
# (My Apps -> New app -> Web app; redirect URI must match XERO_REDIRECT_URI.)
# This script runs a local plain-HTTP callback, so use localhost exactly rather
# than a LAN address, 0.0.0.0, or an IP-literal host.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:8400/callback
# Optional: pin the token cache. auth.py has no --token-file flag and reads
# this path only from the environment or this file, so set it here to make
# auth.py and a scheduled export_tb.py share one cache.
#XERO_TOKEN_FILE=
